          <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Generate Attributes" width="90" x="447" y="34">
            <list key="function_descriptions">
              <parameter key="Number_Passenger" value="replaceAll(trim([Number_Passenger]), &quot;[^0-9]&quot;, &quot;0&quot;)"/>
