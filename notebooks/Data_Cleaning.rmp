      <operator activated="false" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Generate Attributes (2)" width="90" x="514" y="238">
        <list key="function_descriptions">
          <parameter key="Year" value="replaceAll([Date], &quot;^.*?(\\d{4}).*$&quot;, &quot;$1&quot;)"/>
          <parameter key="Month" value="replaceAll([Date], &quot;^\\d{1,2}/(\\d{1,2})/.*$&quot;, &quot;$1&quot;)"/>
          <parameter key="MonthYear" value="concat([Year], &quot;-&quot;, [Month])"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Asia/Bangkok"/>
      </operator>
